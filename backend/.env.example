PORT=5000
MONGODB_URI=mongodb://localhost:27017/embeauty
NODE_ENV=development

# REQUIRED when NODE_ENV=production — the server refuses to boot without them.
# Generate each one separately with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_too_and_keep_it_different

# Comma-separated list of browser origins allowed to call the API.
# Only enforced in production; leave empty in development.
CORS_ORIGINS=https://embeauty.vn,https://www.embeauty.vn
